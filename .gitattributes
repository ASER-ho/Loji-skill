# Normalise line endings on every platform.
#
# `npm run check:meta` compares loji-dsh/lib/skill-meta.json byte for byte
# against a value generated with "\n" endings, and the Python tools read the
# same files as text. A Windows checkout with core.autocrlf=true rewrites them
# to CRLF and the metadata check then reports "Stale metadata" for a tree that
# is perfectly in sync, so the checkout line ending is pinned here instead.
* text=auto eol=lf

# Binary assets must never be touched by the conversion above.
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zip binary
*.tgz binary
*.woff binary
*.woff2 binary

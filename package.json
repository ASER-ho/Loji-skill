{
  "name": "loji-dsh",
  "version": "1.0.1",
  "description": "DeepSeek Harness adapter for 长征机 / 逻辑 / 征酱 (Loji); registers the loji-skill Agent Skill.",
  "license": "MIT",
  "author": "ASER-ho",
  "type": "module",
  "main": "loji-dsh/lib/index.js",
  "exports": {
    ".": "./loji-dsh/lib/index.js",
    "./skill": "./SKILL.md",
    "./package.json": "./package.json"
  },
  "files": [
    "loji-dsh",
    "SKILL.md",
    "references",
    "research",
    "examples",
    "scripts/*.py",
    "memory.template.md",
    "judgments.template.md",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-skills",
    "loji",
    "tfr",
    "roleplay"
  ],
  "dsh": {
    "bundle": {
      "patch": "./loji-dsh/cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "scripts": {
    "sync:meta": "node loji-dsh/scripts/sync-skill-meta.mjs",
    "check:meta": "node loji-dsh/scripts/sync-skill-meta.mjs --check",
    "test": "node --test loji-dsh/tests/*.test.mjs",
    "gen:preset": "node loji-dsh/scripts/gen-preset-patch.mjs",
    "check:preset": "node loji-dsh/scripts/gen-preset-patch.mjs --check",
    "verify:install": "node loji-dsh/scripts/verify-install.mjs"
  }
}
